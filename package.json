{
  "name": "touno",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/frontend/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f infra/compose.yaml up --build",
    "start": "bun run --filter @touno/web start",
    "build": "bun run --filter @touno/web build",
    "test": "bun run --filter @touno/web test && vitest run",
    "lint": "bun run --filter @touno/web lint && bun run lint:tools",
    "lint:tools": "eslint tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:arena": "bun run --filter @touno/web audit:arena",
    "prepare:assets": "bun run --filter @touno/web prepare:assets",
    "serve:static": "bun run --filter @touno/web serve:static",
    "sweep:overflow": "bun run --filter @touno/web sweep:overflow",
    "check": "bun run tools/check/check-all.ts && bun run test && bun run lint && bun run format:check && bun run audit:arena",
    "check:docs": "bun run tools/check/check-docs.ts",
    "check:citations": "bun run tools/check/check-citations.ts",
    "check:agents": "bun run tools/check/check-agents.ts",
    "check:vocabulary": "bun run tools/check/check-vocabulary.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
